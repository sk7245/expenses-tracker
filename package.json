{
  "name": "expenses-tracker",
  "version": "2.0.0",
  "description": "MERN expense tracker: React frontend, Express + MongoDB backend, with login, loans & EMIs, and AI features (auto category, receipt scan, ask questions about your money).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "vite build",
    "dev": "node --watch src/server.js",
    "dev:client": "vite",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sk7245/expenses-tracker.git"
  },
  "author": "Enukonda Sai Krishna",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
