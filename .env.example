# copy this file to .env and fill in the values (never commit .env)

# MongoDB Atlas connection string. Leave empty locally to use a database on this laptop.
MONGODB_URI=

# any long random text, used to sign login tokens
JWT_SECRET=

# free key from https://aistudio.google.com/apikey - AI features stay off without it
GEMINI_API_KEY=

# optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# PORT=3000
